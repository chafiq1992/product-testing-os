# Core app
OPENAI_API_KEY=
# Optional direct Google Secret Manager access using server ADC.
ADS_ANALYZER_OPENAI_SECRET_VERSION=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=1024x1024
AD_LAUNCHER_MODEL=gpt-5.6-sol
AD_LAUNCHER_COPY_MODEL=gpt-5.6-sol
AD_LAUNCHER_COPY_REASONING_EFFORT=high
AD_LAUNCHER_REVIEW_MODEL=gpt-5.6-sol
AD_LAUNCHER_REVIEW_REASONING_EFFORT=high
AD_LAUNCHER_IMAGE_MODEL=gpt-image-2
AD_LAUNCHER_IMAGE_QUALITY=high
AD_LAUNCHER_IMAGE_SIZE=1024x1280
AD_LAUNCHER_REVIEW_THRESHOLD=85
BASE_URL=
PTO_ALLOWED_ORIGINS=
DATABASE_URL=
OAUTH_STATE_SECRET=
META_APP_ID=
META_APP_SECRET=
META_CONNECT_API_VERSION=v26.0
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_ENCRYPTION_KEY=
SYSTEM_ADMIN_USERS={}
SYSTEM_ADMIN_SECRET=

# Sendo merchant workspaces (backend/app/sendo_workspace.py): the delivery app
# (apex-maroc.com) embeds True Profit for its merchants. SENDO_LAUNCH_SECRET
# must equal SERVICES_ENGINE_SECRET in /opt/apex/app.env (32+ chars); unset,
# no launch token verifies and the feature stays off.
SENDO_LAUNCH_SECRET=
SENDO_EMBED_SERVICES=true_profit
SENDO_EMBED_ORIGINS=https://apex-maroc.com
SENDO_DELIVERY_URL=http://apex-web:8080

# API auth gate (backend/app/auth_gate.py). Every API except logins, the
# Shopify OAuth callback, the scheduler tick and the confirmation team's own
# routes requires an operator session. Operators sign in with either the shared
# PRODUCT_TESTING_* credential or any SYSTEM_ADMIN_USERS entry.
PRODUCT_TESTING_USERNAME=
PRODUCT_TESTING_PASSWORD=
# Signs session cookies; set a long random value (falls back to SYSTEM_ADMIN_SECRET).
PRODUCT_TESTING_AUTH_SECRET=
# Emergency kill switch: PTO_AUTH_GATE=off disables enforcement (no rebuild needed).
PTO_AUTH_GATE=
# /docs, /redoc and /openapi.json are served only when this is 1.
PTO_API_DOCS=

# Meta paid ad launcher (Marketing API v26.0)
AD_LAUNCHER_META_API_VERSION=v26.0
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_PIXEL_ID=
# Optional per-store Meta workspaces. Each store can use a separate token, default ad account, Page, Instagram actor, and pixel.
META_ACCESS_TOKEN_IRRAKIDS=
META_AD_ACCOUNT_ID_IRRAKIDS=
META_PAGE_ID_IRRAKIDS=
META_INSTAGRAM_ACCOUNT_ID_IRRAKIDS=
META_PIXEL_ID_IRRAKIDS=
META_ACCESS_TOKEN_IRRANOVA=
META_AD_ACCOUNT_ID_IRRANOVA=
META_PAGE_ID_IRRANOVA=
META_INSTAGRAM_ACCOUNT_ID_IRRANOVA=
META_PIXEL_ID_IRRANOVA=
META_ACCESS_TOKEN_MMD=
META_AD_ACCOUNT_ID_MMD=
META_PAGE_ID_MMD=
META_INSTAGRAM_ACCOUNT_ID_MMD=
META_PIXEL_ID_MMD=

# Google Gemini / Nano Banana image generation
# Used to create clean storefront product images from vendor uploads.
GEMINI_API_KEY=

# Microsoft Clarity Data Export API
# Store the generated project token here, never in source code.
CLARITY_API_TOKEN=
CLARITY_EXPORT_MAX_DAYS=3

# Optional public storefront domains used for Clarity URL matching.
# Examples: SHOPIFY_PUBLIC_DOMAIN_IRRANOVA=www.irranova.com
SHOPIFY_PUBLIC_DOMAIN=
SHOPIFY_PUBLIC_DOMAIN_IRRAKIDS=
SHOPIFY_PUBLIC_DOMAIN_IRRANOVA=
SHOPIFY_PUBLIC_DOMAIN_MMD=

# Shopify API version
SHOPIFY_API_VERSION=2025-07

# Default/fallback Shopify credentials (optional)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Per-store fixed-token setup
SHOPIFY_SHOP_DOMAIN_IRRAKIDS=irrakids.myshopify.com
SHOPIFY_ACCESS_TOKEN_IRRAKIDS=
SHOPIFY_SHOP_DOMAIN_IRRANOVA=irranova.myshopify.com
SHOPIFY_ACCESS_TOKEN_IRRANOVA=
SHOPIFY_SHOP_DOMAIN_MMD=
SHOPIFY_ACCESS_TOKEN_MMD=

# Per-store OAuth app credentials
SHOPIFY_CLIENT_ID_IRRAKIDS=
SHOPIFY_CLIENT_SECRET_IRRAKIDS=
SHOPIFY_CLIENT_ID_IRRANOVA=
SHOPIFY_CLIENT_SECRET_IRRANOVA=
SHOPIFY_CLIENT_ID_MMD=
SHOPIFY_CLIENT_SECRET_MMD=
# Add any new store label to SHOPIFY_OAUTH_STORES, then use the uppercase label suffix:
# SHOPIFY_SHOP_DOMAIN_BEITII=beitii.myshopify.com
# SHOPIFY_CLIENT_ID_BEITII=
# SHOPIFY_CLIENT_SECRET_BEITII=

# Stores allowed to use DB-backed OAuth tokens minted via /api/shopify/oauth/*
SHOPIFY_OAUTH_STORES=irrakids,irranova,mmd

# Recommended Shopify scopes for this app
# read_inventory_transfers lets the ads dashboard show purchase orders (inventory transfers);
# reconnect the store after adding it.
SHOPIFY_OAUTH_SCOPES=read_orders,write_orders,read_all_orders,read_order_edits,write_order_edits,read_products,write_products,read_content,write_content,read_inventory,write_inventory,read_inventory_transfers,read_locations,read_customers,write_customers,read_files,write_files,read_publications,write_publications,read_themes,write_themes
# API version used only for inventory-transfer (purchase order) reads.
SHOPIFY_INVENTORY_API_VERSION=2026-07

# Optional: Inventory Helper (shopify-collector) receiving state for purchase orders.
# When set, a purchase order is "closed" once it is in the helper's received history.
# Use a dedicated collector account; the dashboard only reads receipts.
INVENTORY_HELPER_API_URL=https://shopify-collector.chattbase.site
INVENTORY_HELPER_EMAIL=
INVENTORY_HELPER_PASSWORD=

# Owner analyst (ads dashboard): USD spend is converted to MAD at this rate.
ADS_USD_TO_MAD=10
OWNER_ANALYSIS_WORKERS=3
